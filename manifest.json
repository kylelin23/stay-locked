{
    "manifest_version": 3,
    "name": "Stay Locked",
    "version": "0.1.0",
    "permissions": ["sidePanel", "storage"],
    "host_permissions": ["https://claude.ai/*"],
    "background": { "service_worker": "background.js" },
    "content_scripts": [{ "matches": ["https://claude.ai/*"], "js": ["content.js"] }],
    "side_panel": { "default_path": "panel.html" }
}